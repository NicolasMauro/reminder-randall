# Copy to .env and fill in. Never commit .env.

# --- Who Randall watches (single self-host user) ---
RANDALL_NAME=Your Name
RANDALL_EMAIL=you@example.com
RANDALL_PHONE=+15551234567
RANDALL_ICS_URL=https://calendar.google.com/calendar/ical/xxx/private-xxx/basic.ics

# Public host for the ack magic-links baked into reminders (no scheme).
APP_HOST=localhost:3000

# --- iMessage via LoopMessage (https://loopmessage.com) ---
LOOPMESSAGE_AUTH_KEY=
LOOPMESSAGE_SECRET_KEY=
LOOPMESSAGE_SENDER=your.sender@imsg.im

# --- WhatsApp + phone Call via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+15551234567
TWILIO_CALL_FROM=+15551234567

# --- Email channel (any SMTP; example is Resend) ---
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
